{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "ldap": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "pagedTotal": {
              "description": "LDAP_PAGED_TOTAL_LIMIT: empty (hands off), a positive integer up to 2147483647, \"unlimited\", or \"off\" (remove the rule this setting manages). Checked here so a YAML 1.5 or 0 cannot be turned into a different number or silently dropped on its way to the image, which refuses the same values.",
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^$|^unlimited$|^off$|^([1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$"
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                }
              ]
            }
          }
        }
      }
    }
  }
}
