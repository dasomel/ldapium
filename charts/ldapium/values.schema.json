{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "ldap": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "pagedTotal": {
              "description": "LDAP_PAGED_TOTAL_LIMIT: empty (hands off), a positive integer up to 2147483647, \"unlimited\", or \"off\" (remove the rule this setting manages). Checked here so a YAML 1.5 or 0 cannot be turned into a different number or silently dropped on its way to the image, which refuses the same values.",
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^$|^unlimited$|^off$|^([1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$"
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                }
              ]
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "machineAuth": {
          "type": "object",
          "additionalProperties": false,
          "description": "Machine bearer authentication (#214). Unknown keys are refused on purpose: MACHINE_OIDC_INSECURE_HTTP is a local-test escape hatch that the chart does not expose.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuerURL": {
              "type": "string",
              "pattern": "^$|^https://[^ ]+$"
            },
            "audience": {
              "type": "string",
              "not": {
                "const": "account"
              }
            },
            "allowedClients": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "scopes"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^=;,\\s]+$"
                  },
                  "scopes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "directory.users.read",
                        "directory.groups.read",
                        "directory.tree.read",
                        "directory.entry.read",
                        "directory.policies.read",
                        "server.monitor.read",
                        "audit.read",
                        "server.settings.read"
                      ]
                    }
                  }
                }
              }
            },
            "tokenMaxTTL": {
              "type": "string",
              "pattern": "^[0-9]+(ns|us|ms|s|m|h)([0-9]+(ns|us|ms|s|m|h))*$"
            },
            "clockSkew": {
              "type": "string",
              "pattern": "^[0-9]+(ns|us|ms|s|m|h)([0-9]+(ns|us|ms|s|m|h))*$"
            },
            "ldapBindDN": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string"
            },
            "extraRootDNs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "jwks": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cacheTTL": {
                  "type": "string",
                  "pattern": "^[0-9]+(ns|us|ms|s|m|h)([0-9]+(ns|us|ms|s|m|h))*$"
                },
                "maxStale": {
                  "type": "string",
                  "pattern": "^[0-9]+(ns|us|ms|s|m|h)([0-9]+(ns|us|ms|s|m|h))*$"
                },
                "minRefresh": {
                  "type": "string",
                  "pattern": "^[0-9]+(ns|us|ms|s|m|h)([0-9]+(ns|us|ms|s|m|h))*$"
                }
              }
            },
            "authFailureLimit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "authFailureWindow": {
              "type": "string",
              "pattern": "^[0-9]+(ns|us|ms|s|m|h)([0-9]+(ns|us|ms|s|m|h))*$"
            },
            "rateLimit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "burst": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              }
            },
            "clientConcurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "maxConcurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "maxAuthConcurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "ipLimiterMax": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "requestTimeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            }
          }
        }
      }
    },
    "replication": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string",
          "enum": [
            "admin",
            "prepare",
            "dedicated"
          ]
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        },
        "bindDN": {
          "type": "string"
        }
      }
    }
  }
}
