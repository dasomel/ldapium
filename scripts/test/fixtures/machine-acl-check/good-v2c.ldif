olcAccess: {6}to dn.subtree="ou=managed,dc=example,dc=org" attrs=entry filter=(&(!(objectClass=groupOfNames))(!(creatorsName=uid=machine-write-data,ou=system,dc=example,dc=org))) by dn.exact="uid=machine-write-data,ou=system,dc=example,dc=org" =rsc by * break
