olcAccess: {9}to dn.subtree="ou=people,ou=managed,dc=example,dc=org" attrs=employeeType val.regex="^ldapium-credential-pending:[0-9a-f]{16}$" filter=(&(objectClass=inetOrgPerson)(creatorsName=uid=machine-write-data,ou=system,dc=example,dc=org)(employeeType=ldapium-credential-pending:*)(!(userPassword=*))(!(memberOf=cn=admins,ou=groups,ou=managed,dc=example,dc=org))(!(memberOf=cn=subadmins,ou=groups,ou=managed,dc=example,dc=org))(pwdPolicySubentry=cn=credential-pending,ou=policies,dc=example,dc=org)) by dn.exact="uid=machine-write-data,ou=system,dc=example,dc=org" add by * break
