# Machine WRITE identity W_lock ACL for the MAIN database
# (docs/changes/machine-write-scope, T-020; operator guide docs/machine-write-account.md).
#
# Same single-source rule as write-data.ldif. Tokens:
#
#   @WLOCK_DN@    the dedicated lock account (outside the write subtree)
#   @WRITE_DN@    the write subtree: the union of every client's write cap
#   @SYSTEM_DN@   the container that holds M, W_data, W_lock: a deny backstop
#   @REPL_DN@     the replication identity entry (cn=replicator,<root>): the same
#                 backstop as in write-data.ldif
#   @MAIN_DB_DN@  the config entry of the main database
#
# W_lock may ADD exactly one attribute, pwdAccountLockedTime, and reads the rest
# of the write subtree (for assertions). `add` (not `write`, #394): slapd checks
# delete access for Delete AND Replace, so W_lock can set the lock but can never
# remove or overwrite it (no unlock, no undoing a ppolicy lockout). It cannot
# create or delete entries, and it has no access to userPassword, the other pwd*
# state or memberOf.
# Per-client caps and the lock-target checks are the application guard's job.
#
# Placement: the same as write-data.ldif, after the data rules of the guide's
# defined order. Indices start at {0}; the guide shifts them.
#
#   {0} anything under @SYSTEM_DN@                       none
#   {1} the replication identity entry @REPL_DN@         none
#   {2} secrets, other pwd* state, memberOf              none
#   {3} pwdAccountLockedTime inside @WRITE_DN@           add (no delete)
#   {4} everything else inside @WRITE_DN@                read
#   {5} everything else                                  none
dn: @MAIN_DB_DN@
changetype: modify
add: olcAccess
olcAccess: {0}to dn.subtree="@SYSTEM_DN@"
  by dn.exact="@WLOCK_DN@" none
  by * break
olcAccess: {1}to dn.exact="@REPL_DN@"
  by dn.exact="@WLOCK_DN@" none
  by * break
olcAccess: {2}to attrs=userPassword,shadowLastChange,pwdHistory,pKCS8PrivateKey,userPKCS12,oathSecret,oathEncKey,oathTokenPIN,memberOf,pwdChangedTime,pwdFailureTime,pwdGraceUseTime,pwdReset,pwdPolicySubentry,pwdStartTime,pwdEndTime,pwdLastSuccess
  by dn.exact="@WLOCK_DN@" none
  by * break
olcAccess: {3}to dn.subtree="@WRITE_DN@" attrs=pwdAccountLockedTime
  by dn.exact="@WLOCK_DN@" add
  by * break
olcAccess: {4}to dn.subtree="@WRITE_DN@"
  by dn.exact="@WLOCK_DN@" read
  by * break
olcAccess: {5}to *
  by dn.exact="@WLOCK_DN@" none
  by * break
