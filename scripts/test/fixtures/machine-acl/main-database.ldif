# Machine execution identity ACL for the MAIN database
# (docs/changes/machine-principal-auth, "Machine LDAP account and ACL").
#
# The single source of this LDIF text: the live tests apply it with the tokens
# below substituted, and docs/machine-ldap-account.md embeds it verbatim (the
# test scripts/test/test-machine-acl-readonly-live.py fails if the two differ).
#
#   @MACHINE_DN@  the dedicated read-only account (outside the allowed subtree)
#   @ALLOWED_DN@  the allowed subtree B (default: the base DN)
#   @MAIN_DB_DN@  the config entry of the main database, e.g.
#                 olcDatabase={1}mdb,cn=config
#
# The secret attribute list in rule {0} is derived from the schema this image
# loads (docs/machine-ldap-account.md, "Secret attributes"): userPassword and
# shadowLastChange (the pairing the image's own first rule uses), pwdHistory
# (previous password hashes), pKCS8PrivateKey and userPKCS12 (key material),
# oathSecret, oathEncKey and oathTokenPIN (the otp overlay's token secrets).
#
# The three rules go in front of EVERY existing allow rule ({0}-{2}); each ends
# in "by * break" so every other identity continues to the existing rules
# unchanged. Two leading spaces on a continuation line are required: LDIF
# folding strips one, the other is the separator before "by".
dn: @MAIN_DB_DN@
changetype: modify
add: olcAccess
olcAccess: {0}to attrs=userPassword,shadowLastChange,pwdHistory,pKCS8PrivateKey,userPKCS12,oathSecret,oathEncKey,oathTokenPIN
  by dn.exact="@MACHINE_DN@" none
  by * break
olcAccess: {1}to dn.subtree="@ALLOWED_DN@"
  by dn.exact="@MACHINE_DN@" read
  by * break
olcAccess: {2}to *
  by dn.exact="@MACHINE_DN@" none
  by * break
