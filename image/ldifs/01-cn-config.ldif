#
# cn=config bootstrap template — rendered by entrypoint.sh (token substitution)
# and loaded once, on first launch, via slapadd -n 0.
#
# The monitor backend is enabled with a dedicated monitor root DN. The
# monitoring password deliberately reuses the already-required admin secret
# for now; the chart keeps the exporter internal and never exposes it through
# a Service. A future hardening pass can split the secret without changing the
# Prometheus contract.
#
# Tokens replaced by entrypoint.sh include the LDAP root/admin values and the
# existing __LDAP_ADMIN_PW_HASH__ used for the monitor root password.

dn: cn=config
objectClass: olcGlobal
cn: config
olcArgsFile: __LDAP_RUN_DIR__/slapd.args
olcPidFile: __LDAP_RUN_DIR__/slapd.pid
#__TLS_ATTRS__

dn: cn=module,cn=config
objectClass: olcModuleList
cn: module
olcModulepath: /usr/lib/openldap
olcModuleload: back_mdb.la
olcModuleload: argon2.la
olcModuleload: memberof.la
olcModuleload: refint.la
olcModuleload: ppolicy.la
olcModuleload: unique.la
olcModuleload: syncprov.la
olcModuleload: accesslog.la
olcModuleload: auditlog.la
olcModuleload: constraint.la
olcModuleload: deref.la
olcModuleload: dynlist.la
olcModuleload: sssvlv.la
olcModuleload: otp.la

dn: cn=schema,cn=config
objectClass: olcSchemaConfig
cn: schema

# `include:` is a slapd config *directive*, not an attribute of the entry
# above, so each one has to stand alone as its own LDIF record. Folded into
# the cn=schema entry they are parsed as attributes instead, and slapadd -n 0
# aborts with `str2ad(include): attribute type undefined`. The blank lines
# below are load-bearing for the same reason — LDIF separates records by
# blank lines, so two adjacent include lines are one record, not two. This
# mirrors servers/slapd/slapd.ldif in the OpenLDAP source.
include: file:///etc/openldap/schema/core.ldif

include: file:///etc/openldap/schema/cosine.ldif

include: file:///etc/openldap/schema/inetorgperson.ldif

include: file:///etc/openldap/schema/nis.ldif

dn: olcDatabase=frontend,cn=config
objectClass: olcDatabaseConfig
objectClass: olcFrontendConfig
olcDatabase: frontend
olcPasswordHash: __LDAP_PASSWORD_HASH__

dn: olcDatabase={1}mdb,cn=config
objectClass: olcDatabaseConfig
objectClass: olcMdbConfig
olcDatabase: mdb
olcDbMaxSize: __LDAP_DB_MAX_SIZE__
olcSuffix: __LDAP_ROOT_DN__
olcRootDN: __LDAP_ADMIN_DN__
olcRootPW: __LDAP_ADMIN_PW_HASH__
olcDbDirectory: __LDAP_DATA_DIR__
olcSizeLimit: __LDAP_SIZE_LIMIT__
olcTimeLimit: __LDAP_TIME_LIMIT__
olcDbIndex: objectClass eq
olcDbIndex: entryUUID eq
olcDbIndex: entryCSN eq
olcDbIndex: uid eq
olcDbIndex: cn pres,eq,sub
olcDbIndex: mail eq
olcDbIndex: memberOf eq
olcDbIndex: member eq
olcDbIndex: sn pres,eq,sub
olcDbIndex: givenName eq
olcAccess: {0}to attrs=userPassword,shadowLastChange
  by self write
  by anonymous auth
  by * none
olcAccess: {1}to attrs=entry,uid,objectClass
  by anonymous read
  by users read
  by self write
olcAccess: {2}to *
  by self write
  by users read
  by anonymous none

dn: olcOverlay=memberof,olcDatabase={1}mdb,cn=config
objectClass: olcOverlayConfig
objectClass: olcMemberOfConfig
olcOverlay: memberof
olcMemberOfRefint: TRUE

dn: olcOverlay=refint,olcDatabase={1}mdb,cn=config
objectClass: olcOverlayConfig
objectClass: olcRefintConfig
olcOverlay: refint
olcRefintAttribute: memberof
olcRefintAttribute: member
olcRefintAttribute: manager
olcRefintAttribute: owner

dn: olcOverlay=ppolicy,olcDatabase={1}mdb,cn=config
objectClass: olcOverlayConfig
objectClass: olcPPolicyConfig
olcOverlay: ppolicy
olcPPolicyHashCleartext: TRUE
#__PPOLICY_DEFAULT__

#__UNIQUE_OVERLAY__

# OpenLDAP monitor backend. The exporter binds as this root DN and is only
# reachable through the internal metrics Service.
dn: olcDatabase=monitor,cn=config
objectClass: olcDatabaseConfig
objectClass: olcMonitorConfig
olcDatabase: monitor
olcRootDN: cn=monitoring,cn=Monitor
olcRootPW: __LDAP_ADMIN_PW_HASH__
olcMonitoring: TRUE
olcAccess: {0}to * by dn.exact="cn=monitoring,cn=Monitor" read by * none
