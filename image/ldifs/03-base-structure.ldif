#
# Base DIT template — rendered by entrypoint.sh and loaded once, on first
# launch, directly into the mdb database via:
#   slapadd -n 1 -F <config-dir> -l <rendered-file>
#
# This creates the root suffix entry, the admin entry, and (by default) a
# password policy container — no sample users, groups, or other OUs. That
# is intentional: this image never seeds demo data. The policy entries are
# operational scaffolding the ppolicy overlay needs to do anything at all
# (see LDAP_PASSWORD_POLICY_ENABLED in image/README.md, "Password policy"),
# not sample content, so they don't violate that principle. Anything
# beyond what's here belongs in LDAP_SEED_DIR.
#
# Tokens replaced by entrypoint.sh:
#   __LDAP_ROOT_DN__        e.g. dc=example,dc=org
#   __LDAP_ROOT_DC__        first dc= RDN value, e.g. example
#   __LDAP_ORG_NAME__       e.g. Example Org
#   __LDAP_ADMIN_DN__       e.g. cn=admin,dc=example,dc=org
#   __LDAP_ADMIN_RDN_VALUE__ first RDN value of the admin DN, e.g. admin
#   __LDAP_ADMIN_PW_HASH__  output of `slappasswd -h "$LDAP_PASSWORD_HASH"`
#                           (default {ARGON2})
#   #__PASSWORD_POLICY__    (full-line anchor, see the ANCHOR note in
#                           entrypoint.sh) replaced with the whole
#                           ou=policies + cn=default pwdPolicy entry pair
#                           built from LDAP_PASSWORD_POLICY_ENABLED and
#                           friends, or dropped with no replacement when
#                           the policy is disabled
#
dn: __LDAP_ROOT_DN__
objectClass: dcObject
objectClass: organization
o: __LDAP_ORG_NAME__
dc: __LDAP_ROOT_DC__

dn: __LDAP_ADMIN_DN__
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: __LDAP_ADMIN_RDN_VALUE__
description: LDAP administrator
userPassword: __LDAP_ADMIN_PW_HASH__

#__PASSWORD_POLICY__
