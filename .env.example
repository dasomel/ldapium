# Copy to .env and fill in real values before `docker compose up`.
#   cp .env.example .env
# .env is already git-ignored — never commit it once it holds real secrets.

# --- Required --------------------------------------------------------------

# Root DN of the directory. Must start with "dc=".
LDAP_ROOT_DN=dc=example,dc=org

# Admin bind password. No default, ever — see image/README.md and
# charts/openldap/README.md for why. Pick a real value, not the example.
LDAP_ADMIN_PASSWORD=

# HMAC key the UI signs session cookies with. 32+ random bytes. Generate one
# with:
#   openssl rand -base64 32
SESSION_SECRET=

# --- Optional (defaults shown are docker-compose.yml's own) ----------------

# LDAP_LOG_LEVEL=stats
# LDAP_USER_SEARCH_FILTER=(uid=%s)
# LDAP_PORT=389
# UI_PORT=8080

# Only relevant once images are published (see docker-compose.yml's comment
# on the `ldap`/`ui` services) — leave unset to build locally.
# OPENLDAP_IMAGE=ghcr.io/dasomel/openldap-suite:2.6.14
# UI_IMAGE=ghcr.io/dasomel/openldap-suite-ui:2.6.14
